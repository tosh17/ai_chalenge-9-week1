DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
PORT=8080

# Local LAN Qwen (OpenAI-compatible). See \\10.10.0.220\LLM-howto
LOCAL_ENABLED=true
LOCAL_API_URL=http://10.10.0.220:8787/v1
LOCAL_API_KEY=your_local_api_key_here
LOCAL_MODEL=qwen-local
LOCAL_TITLE=Local-Qwen
# Qwen context window (tokens)
LOCAL_CONTEXT_LIMIT=256000

# Persistent chat history (JSON). Survives process restarts.
CHAT_HISTORY_PATH=data/chat-history.json

# DeepSeek context window in tokens (V4 Flash ≈ 1_000_000).
CONTEXT_TOKEN_LIMIT=1000000

# Day10 context strategies: sliding | facts | branch
CONTEXT_STRATEGY=sliding
SLIDING_WINDOW_N=8
FACTS_WINDOW_N=6
# 0 = вся история активной ветки
BRANCH_WINDOW_N=0

# Legacy day9 compression (off when using day10 strategies in server)
COMPRESS_ENABLED=false
COMPRESS_KEEP_LAST=6
COMPRESS_EVERY=10
